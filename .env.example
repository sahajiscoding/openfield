# ── Openfield · env ─────────────────────────────────────────────────────
# Copy to .env.local and fill in. Only NEXT_PUBLIC_* reach the browser —
# everything else stays on the server. Add the same vars in Vercel →
# Project → Settings → Environment Variables (Production + Preview).

# 1) Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 2) Supabase Auth + database (required for sign-in AND token billing)
#    Create a project at https://supabase.com → Project Settings → API.
#    Run supabase/migrations/001_generations.sql then 002_credits.sql in SQL Editor.
#    Auth → URL Configuration → Redirect URLs must include:
#      http://localhost:3000/auth/callback  (plus your Vercel URL later)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Required for wallets/ledger/orders (service role bypasses RLS
# by design — these tables expose NOTHING to anon/authenticated keys).
# NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# 3) Higgsfield operator key (required for generation)
#    The ONE key every generation runs on. Format id:secret, e.g. ab12:9f...
#    Server-only. Get it from the Higgsfield team / https://console.higgsfield.ai
HF_API_KEY=
#    API origin. Defaults to https://api.higgsfield.ai — set only to override.
HF_API_BASE_URL=

# 4) UroPay merchant credentials (required for token checkout)
#    Hosted checkout via https://api.uropai.in (same scheme as MUN-AI-APP).
#    Get API KEY + API SECRET + WEBHOOK SECRET from the UroPay dashboard.
#    Requests are HMAC-signed (X-Api-Key / X-Timestamp / X-Nonce /
#    X-Signature); webhooks are verified with the SEPARATE webhook secret.
#    Set the dashboard webhook to https://<your-app>/api/uropay/webhook
#    Server-only. Base override rarely needed.
UROPAY_API_KEY=
UROPAY_API_SECRET=
UROPAY_WEBHOOK_SECRET=
UROPAY_BASE_URL=https://api.uropai.in

# 4) Uploads live in Supabase Storage (bucket `openfield-uploads`, created by
#    migration 001, public read so the Higgsfield API can fetch reference
#    frames). No extra env needed — SERVICE_ROLE_KEY above covers it.
