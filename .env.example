# ── Openfield · merged env ──────────────────────────────────────────────
# Copy to .env.local and fill in. The app runs without generation keys
# (landing + login + studio shell all render); generation prompts for keys.

# 1) Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 2) Supabase Auth + Storage (required for sign-in)
#    Create a project at https://supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Only needed for admin/storage helpers. Never expose with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# 3) Higgsfield-compatible generation API (from open-higgsfield .env.example)
#    Server-only origin, e.g. https://api.higgsfield.ai/v1 (you paste this later)
HF_API_BASE_URL=
#    Vercel Blob token for start/end/reference uploads. Optional — if empty,
#    /api/blob returns 503 and the studio falls back to Supabase Storage.
OPEN_HIGGSFIELD_READ_WRITE_TOKEN=

# 4) MuAPI gateway (from open-generative-ai — 400+ models via x-api-key)
#    Server default so logged-in users can generate before pasting their own.
#    Get one at https://muapi.ai/access-keys
MUAPI_BASE_URL=https://api.muapi.ai
MUAPI_API_KEY=
#    Public flag for UI copy only (never a secret).
NEXT_PUBLIC_MUAPI_ENABLED=true
